og/2024-10-30-how-to-change-table-border-color-in-react-js/","prevSlug":"/blog/2024-10-31-how-to-change-title-background-color-in-react-js/","nextSlug":"/blog/2024-10-30-how-to-change-table-font-size-in-react-js/"}},"staticQueryHashes":["2555585279","2714594843","3159585216"]}