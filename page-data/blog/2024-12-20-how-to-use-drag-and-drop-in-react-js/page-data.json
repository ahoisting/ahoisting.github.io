eact-js/"}}},"pageContext":{"slug":"/blog/2024-12-20-how-to-use-drag-and-drop-in-react-js/","prevSlug":"/blog/2024-12-21-how-to-use-draft-js-in-react-js/","nextSlug":"/blog/2024-12-20-how-to-use-datepicker-in-react-js/"}},"staticQueryHashes":["2555585279","2714594843","3159585216"]}